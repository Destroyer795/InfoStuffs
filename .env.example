VITE_API_BASE_URL=http://localhost:5000
VITE_CLERK_PUBLISHABLE_KEY="Your Clerk Publishable Key"
# Backend only. Never prefix R2 credentials with VITE_ or pass them to frontend builds.
R2_ACCOUNT_ID="Your Cloudflare Account ID"
R2_ACCESS_KEY_ID="Your R2 Access Key ID"
R2_SECRET_ACCESS_KEY="Your R2 Secret Access Key"
R2_BUCKET_NAME="Your Private R2 Bucket Name"
MONGO_URI="Your MongoDB URI"
PORT=5000
CLERK_SECRET_KEY="Your Clerk Secret Key"
CRON_SECRET="Your Cron Secret for Vercel Cron Jobs"
NODE_ENV=development

# Optional, used only by the migration script with a privileged server-side storage key.
# SUPABASE_URL=https://your-source-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_source_service_role_key
# SUPABASE_KEY may be used instead of SUPABASE_SERVICE_ROLE_KEY.
